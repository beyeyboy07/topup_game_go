    "definitions": {
        "controllers.GameRequest": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "ML"
                },
                "name": {
                    "type": "string",
                    "example": "Mobile Legends"
                }
            }
        },
        "controllers.OrderRequest": {
            "type": "object",
            "properties": {
                "player_id": {
                    "type": "string",
                    "example": "123456789"
                },
                "product_id": {
                    "type": "integer",
                    "example": 1
                },
                "server_id": {
                    "type": "string",
                    "example": "1234"
                }
            }
        },
        "controllers.ProductRequest": {
            "type": "object",
            "properties": {
                "buy_price": {
                    "type": "integer",
                    "example": 10000
                },
                "code": {
                    "type": "string",
                    "example": "ML86"
                },
                "game_id": {
                    "type": "integer",
                    "example": 1
                },
                "name": {
                    "type": "string",
                    "example": "86 Diamonds"
                },
                "sell_price": {
                    "type": "integer",
                    "example": 12000
                }
            }
        },
        "controllers.ProviderRequest": {
            "type": "object",
            "properties": {
                "api_key": {
                    "type": "string",
                    "example": "secret-key"
                },
                "base_url": {
                    "type": "string",
                    "example": "https://api.example.com"
                },
                "code": {
                    "type": "string",
                    "example": "DIGIFLAZZ"
                },
                "name": {
                    "type": "string",
                    "example": "Digiflazz"
                },
                "status": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "utils.APIResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "description": "Data yang dikirim API."
                },
                "message": {
                    "description": "Message dari API.",
                    "type": "string"
                },
                "status": {
                    "description": "Status response.\nContoh: success / error",
                    "type": "string"
                }
            }
        }
